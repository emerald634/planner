+"""Safe local pytest: no real config/DBs, no external network, existing tests unchanged."""
+
+import json
+import os
+import secrets
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+
+def main() -> int:
+    backend = Path(__file__).resolve().parents[1]
+    scratch = backend.parents[1] / "unified-auth-checks"
+    scratch.mkdir(exist_ok=True)
+    os.environ["TEMP"] = os.environ["TMP"] = str(scratch)
+    tempfile.tempdir = str(scratch)
+    for name in tuple(os.environ):
+        if any(
+            part in name.upper()
+            for part in ("TOKEN", "PASSWORD", "SECRET", "WEBHOOK", "DATABASE_URL")
+        ):
+            os.environ.pop(name, None)
+    os.environ.update(
+        DATABASE_URL="sqlite://",
+        JWT_SECRET=secrets.token_urlsafe(48),
+        FIRST_ADMIN_PASSWORD="synthetic-bootstrap-not-used",
+        COOKIE_SECURE="false",
+        TELEGRAM_BOT_TOKEN="",
+        BITRIX24_WEBHOOK_URL="",
+        PYTHONDONTWRITEBYTECODE="1",
+    )
+    os.chdir(backend)
+
+    def guard(event, args):
+        if event == "sqlite3.connect" and args[0] != ":memory:":
+            raise PermissionError("Only synthetic in-memory SQLite is allowed")
+        if event == "open" and isinstance(args[0], (str, bytes, os.PathLike)):
+            name = Path(os.fsdecode(args[0])).name
+            if name == ".env" or name.endswith(".env"):
+                raise PermissionError("Do not read environment files in tests")
+        if event == "socket.connect":
+            address = args[1]
+            if not isinstance(address, tuple) or address[0] not in ("127.0.0.1", "::1"):
+                raise PermissionError("External networking is disabled")
+        if event == "socket.getaddrinfo" and args[0] not in (None, "localhost", "127.0.0.1", "::1"):
+            raise PermissionError("External DNS is disabled")
+
+    sys.addaudithook(guard)
+    import pytest
+
+    class Results:
+        def __init__(self):
+            self.tests = []
+
+        def pytest_runtest_logreport(self, report):
+            if report.when == "call" or report.failed:
+                self.tests.append(
+                    {"id": report.nodeid, "phase": report.when, "outcome": report.outcome}
+                )
+
+    plugin = Results()
+    started = time.monotonic()
+    code = pytest.main(["-q", "-p", "no:cacheprovider", *sys.argv[1:]], plugins=[plugin])
+    report = {
+        "exit_code": int(code),
+        "seconds": round(time.monotonic() - started, 3),
+        "tests": plugin.tests,
+        "sqlite_only": True,
+        "postgresql_tested": False,
+    }
+    (scratch / "leadflow-pytest-results.json").write_text(
+        json.dumps(report, indent=2), encoding="utf-8"
+    )
+    return int(code)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
