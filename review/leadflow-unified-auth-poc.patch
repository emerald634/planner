+"""Local identity proof using the ORIGINAL LeadFlow auth boundary.
+
+No second password/token/session implementation. No planner DB or business API.
+This factory is never registered by app.main or the existing deployment entrypoint.
+"""
+
+from fastapi import APIRouter, Depends, FastAPI
+from pydantic import BaseModel
+
+from app.api.dependencies import get_current_user, require_roles
+from app.api.router import api_router
+from app.core.config import settings
+from app.models.user import User, UserRole
+
+
+class IdentityRead(BaseModel):
+    canonical_user_id: int
+    current_role: UserRole
+
+
+def create_poc_app() -> FastAPI:
+    app = FastAPI(title="LOCAL ONLY: shared identity proof", docs_url=None, redoc_url=None)
+    app.include_router(api_router, prefix=settings.api_prefix)
+    router = APIRouter()
+
+    @router.get("/identity", response_model=IdentityRead)
+    def identity(user: User = Depends(get_current_user)) -> IdentityRead:
+        return IdentityRead(canonical_user_id=user.id, current_role=user.role)
+
+    @router.get("/supervisor-check", response_model=IdentityRead)
+    def supervisor_identity(
+        user: User = Depends(require_roles(UserRole.SUPERVISOR)),
+    ) -> IdentityRead:
+        # admin does not imply planner-supervisor; this is NOT a business grant.
+        return IdentityRead(canonical_user_id=user.id, current_role=user.role)
+
+    app.include_router(router, prefix=settings.api_prefix + "/planner-poc")
+    return app
diff --git a/backend/tests/test_unified_auth_poc.py b/backend/tests/test_unified_auth_poc.py
new file mode 100644
index 0000000000000000000000000000000000000000..96fdaec141b538f48670dd510383633a8e3e50e1
