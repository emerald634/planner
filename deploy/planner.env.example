# Non-secret Mini App settings based on the supplied VPS inspection.
# Keep BOT_TOKEN / ADMIN_TELEGRAM_IDS in the existing root .env.
PLANNER_ACCESS_DIR=/opt/bitrix_missed_calls_bot/data
PLANNER_DATA_DIR=/opt/bitrix_missed_calls_bot/planner-data
# Free when inspected; recheck immediately before starting the service.
PLANNER_PORT=18080
# Use a different tag for every release; keep the previous image for rollback.
PLANNER_IMAGE=bitrix-workday-planner:stage2-1-production-v1
BOT_RELEASE_IMAGE=bitrix-missed-calls-bot:stage2-1-production-v1
DISTRIBUTION_QUEUE_DIR=/opt/bitrix_missed_calls_bot/distribution-queue
DISTRIBUTION_CONFIRMER_IDS=8306778724
PLANNER_ACTIVE_MANAGER_IDS=8306778724,7939114214
# Fill according to the existing MANAGER_N_NAME order; do not guess the slots.
MANAGER_1_TELEGRAM_ID=
MANAGER_2_TELEGRAM_ID=
MANAGER_3_TELEGRAM_ID=
