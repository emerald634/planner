# Dedicated site in the existing HOST Nginx; never replace other sites.
# Install only after issuing the certificate using planner.nginx.http.example.
server {
    listen 80;
    listen [::]:80;
    server_name planner.example.com;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/bitrix-workday-planner-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name planner.example.com;
    ssl_certificate /etc/letsencrypt/live/planner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/planner.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    large_client_header_buffers 4 16k;
    # Do not log URL queries/headers containing authentication material.
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
}
